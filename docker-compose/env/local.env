# ========================
# Rutas de repositorios vecinos
# ========================
# Clona estos repos al mismo nivel que este directorio `infrastructure`
USUARIOS_DIR=../../users
EVENTS_DIR=../../events
GATEWAY_DIR=../../gateway
IDENTITY_DIR=../../identity
SURVEYS_DIR=../../surveys
FRONTEND_DIR=../../front-web

# ========================
# Credenciales MySQL
# ========================
# Base de datos de usuarios
MYSQL_ROOT_PASSWORD=root
USERS_DB=tfm_users
USERS_USER=tfm_users_rw
USERS_PASS=tfm_users_password

# Base de datos de eventos
EVENTS_DB=tfm_events
EVENTS_USER=tfm_events_rw
EVENTS_PASS=tfm_events_password

# Base de datos de encuestas
SURVEYS_DB=tfm_surveys
SURVEYS_USER=tfm_surveys_rw
SURVEYS_PASS=tfm_surveys_password

# ========================
# Realm/Keycloak
# ========================
KC_REALM=tfm-bandas
KC_URL_INTERNAL=http://keycloak:8080
KC_JWKS=${KC_URL_INTERNAL}/realms/${KC_REALM}/protocol/openid-connect/certs
KC_ADMIN_CLIENT_ID=realm-admin
KC_ADMIN_CLIENT_SECRET=8nWwBGuo0RxdRQfHUaQgcqv7Fibt8JYX
KC_PERMITTED_ROLES=ADMIN,MUSICIAN

# ========================
# Puertos publicados en el host
# ========================
# Dentro de los contenedores, los microservicios siguen escuchando normalmente en 8080.
KEYCLOAK_PORT=8080
USERS_PORT=8081
SCORES_PORT=8082
EVENTS_PORT=8083
SURVEYS_PORT=8084
GATEWAY_PORT=8085
IDENTITY_PORT=8086

MYSQL_PORT=3307
KEYCLOAK_MYSQL_PORT=3308

FRONTEND_PORT=5173  

# El puerto de management/health de Spring Boot es 8081 dentro del contenedor.
MANAGEMENT_PORT=8081

# ========================
# Gateway y microservicios
# ========================
GATEWAY_URI=http://gateway:8080
# URIs internas de los microservicios dentro del entorno Docker
GATEWAY_USERS_URI=http://users:8080
GATEWAY_EVENTS_URI=http://events:8080
GATEWAY_SCORES_URI=http://scores:8080
GATEWAY_SURVEYS_URI=http://surveys:8080
# Identity service URI, no esta en Gateway, solo se accede desde Users
IDENTITY_SERVICE_URI=http://identity:8080

# Paths gestionados por el gateway (mismo formato que en local)
GATEWAY_USERS_PATH=/api/users/**
GATEWAY_INSTRUMENTS_PATH=/api/instruments/**
GATEWAY_ROLES_PATH=/api/roles/**
GATEWAY_EVENTS_PATH=/api/events/**
GATEWAY_SCORES_PATH=/api/scores/**
GATEWAY_SURVEYS_PATH=/api/surveys/**

